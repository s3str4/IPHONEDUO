; Engine configuration file.
; Route de Nuit — jeu iPhone d'arcade nocturne, esthétique PS1 low-poly.

config_version=5

[application]

config/name="Route de Nuit"
config/description="Une nuit, une route, atteindre l'aube."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

; Base de l'interface : 270×480 (mise à l'échelle sans flou) ; la 3D est
; rendue à la pleine résolution de l'écran.
window/size/viewport_width=270
window/size/viewport_height=480
; Fenêtre de prévisualisation sur PC : portrait, comme l'iPhone.
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
; Navigateur (version web) : rendu à la résolution CSS, pas à celle de l'écran
; Retina (3× plus de pixels, trop lourd pour Safari sur iPhone).
window/dpi/allow_hidpi.web=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
; Textures compressées pour mobile (ETC2/ASTC : iPhone, Safari).
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2

[shader_globals]

fog_color={
"type": "color",
"value": Color(0.05, 0.06, 0.12, 1)
}
fog_start={
"type": "float",
"value": 40.0
}
fog_end={
"type": "float",
"value": 320.0
}
lights_tex={
"type": "sampler2D",
"value": ""
}
light_count={
"type": "float",
"value": 0.0
}
head_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
head_dir={
"type": "vec3",
"value": Vector3(0, 0, -1)
}
reflection_tex={
"type": "sampler2D",
"value": ""
}
mirror_plane={
"type": "vec4",
"value": Vector4(0, 1, 0, 0)
}
reflection_on={
"type": "float",
"value": 0.0
}
sky_ambient={
"type": "color",
"value": Color(0.15, 0.1, 0.25, 1)
}
car_env_tex={
"type": "sampler2D",
"value": ""
}
car_env_on={
"type": "float",
"value": 0.0
}
car_env_tan={
"type": "float",
"value": 2.75
}
car_env_x={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
car_env_y={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
car_env_z={
"type": "vec3",
"value": Vector3(0, 0, 1)
}

[audio]

driver/output_latency.web=80
general/default_playback_type.web=0
